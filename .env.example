# ========================================
# ResQ Environment Variables
# ========================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to GitHub!
# ========================================

# ========== BACKEND CONFIGURATION ==========

# For Railway Deployment: Use OpenAI (Ollama not supported)
# Get key from: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk-proj-your-api-key-here
OPENAI_MODEL=gpt-4o

# For Local Development: Use Ollama (FREE, no costs)
# Requires: ollama pull llama2
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Python configuration
PYTHONUNBUFFERED=1
PYTHON_VERSION=3.10

# ========== FRONTEND CONFIGURATION ==========

# Backend API URL for the browser. Leave empty to use same-origin rewrites.
# Local direct mode: http://localhost:8001
# Vercel direct mode: https://your-backend-service.up.railway.app
NEXT_PUBLIC_API_URL=

# Backend URL used by Next.js rewrites.
# Local: http://localhost:8001
# Vercel: https://your-backend-service.up.railway.app
BACKEND_URL=http://localhost:8001

# Environment mode
NODE_ENV=development

# ========== OPTIONAL ==========

# Database URL (if using database)
# DATABASE_URL=postgresql://user:password@localhost:5432/resumeats

# Debug mode
# DEBUG=true
