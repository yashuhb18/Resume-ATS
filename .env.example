# ========================================
# ResQ Environment Variables
# ========================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to GitHub!
# ========================================

# ========== BACKEND CONFIGURATION ==========

# For Render Deployment: Use OpenAI (Ollama not supported)
# Get key from: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk-proj-your-api-key-here
OPENAI_MODEL=gpt-4o

# For Local Development: Use Ollama (FREE, no costs)
# Requires: ollama pull llama2
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Python configuration
PYTHONUNBUFFERED=1
PYTHON_VERSION=3.10

# ========== FRONTEND CONFIGURATION ==========

# Backend API URL
# Local: http://localhost:8001
# Render: https://your-backend-service.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8001

# Environment mode
NODE_ENV=development

# ========== OPTIONAL ==========

# Database URL (if using database)
# DATABASE_URL=postgresql://user:password@localhost:5432/resumeats

# Debug mode
# DEBUG=true
